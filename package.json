{
  "name": "gresui-web",
  "version": "1.0.0",
  "description": "gresui as a web app — a fast, friendly PostgreSQL client in your browser. Adds an MCP service layer to the tables you choose — it's fancy.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrancisTCE/gresui-web.git"
  },
  "keywords": [
    "postgresql",
    "database",
    "client",
    "web"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "gresui-web": "bin/gresui-web.js"
  },
  "files": [
    "bin/",
    "backend/",
    "shared/",
    "dist/"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "bun run backend/main.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
